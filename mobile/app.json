{
  "expo": {
    "name": "Interpreter.ai",
    "slug": "interpreter-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "interpreterai",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ai.interpreter.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Interpreter.ai uses the microphone to translate live speech."
      }
    },
    "android": {
      "package": "ai.interpreter.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "@config-plugins/react-native-webrtc"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
