{
  "expo": {
    "name": "speaktele",
    "slug": "speaktele",
    "owner": "reignai",
    "version": "1.1.0",
    "icon": "./assets/interpreter-mark-clean.png",
    "orientation": "portrait",
    "scheme": "interpreterai",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.speakapp.speaktest",
      "buildNumber": "21",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Interpreter.ai uses the microphone for translation and voice or video calls.",
        "NSCameraUsageDescription": "Interpreter.ai uses the camera when you start or accept a video call.",
        "UIBackgroundModes": [
          "audio",
          "remote-notification",
          "voip"
        ]
      }
    },
    "android": {
      "package": "ai.interpreter.mobile",
      "edgeToEdgeEnabled": true,
      "versionCode": 17,
      "adaptiveIcon": {
        "foregroundImage": "./assets/interpreter-mark-clean.png",
        "backgroundColor": "#F8FBFF"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.READ_CONTACTS"
      ],
      "blockedPermissions": [
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Interpreter to access your contacts only when you choose My Contacts."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#075BFF"
        }
      ],
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication"
          },
          "ios": {
            "enableMultitaskingCameraAccess": false
          }
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "splash": {
      "image": "./assets/interpreter-mark-clean.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FBFF"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "livekitUrl": "",
      "supabasePublishableKey": "",
      "supabaseUrl": "",
      "eas": {
        "projectId": "d48f551e-34c4-436d-8cca-17a49930647a"
      }
    }
  }
}
