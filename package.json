{
  "name": "interpreter-ai-mobile",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:server": "node server.js",
    "check:providers": "node -r dotenv/config scripts/check-provider-connectivity.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:browser": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "cors": "2.8.5",
    "dotenv": "17.2.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-linear-gradient": "~15.0.0",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-status-bar": "~3.0.0",
    "express": "5.1.0",
    "helmet": "8.1.0",
    "libphonenumber-js": "^1.13.10",
    "livekit-server-sdk": "^2.17.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "@types/ws": "^8.18.1",
    "typescript": "~5.9.2"
  }
}
